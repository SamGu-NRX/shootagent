<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent for the public demo on the demo MacBook. Replace /Users/samgu with your home folder.
     launchd does not expand $HOME, so paths are absolute. No secrets here: serve-public.sh reads
     .env.local and .env itself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.sillion.shootagent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/samgu/Programming Projects/shootagent/scripts/serve-public.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/samgu/Programming Projects/shootagent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TUNNEL</key>
    <string>shootagent</string>
    <key>PATH</key>
    <string>/Users/samgu/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/samgu/Programming Projects/shootagent/data/logs/public.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/samgu/Programming Projects/shootagent/data/logs/public.log</string>
</dict>
</plist>
