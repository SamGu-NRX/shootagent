# Claude drives the agent and the vision self-check. Either an API key, or a gateway URL + token.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:8317
# ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# OpenAI-compatible image edits for generative fills (gpt-image-2). Optional: without it, removals use local LaMa only.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
IMAGE_EDIT_MODEL=gpt-image-2

# Local models run on CUDA, Apple MPS or CPU. Leave empty to auto-detect.
TORCH_DEVICE=
DATA_DIR=data

# AutoHDR hackathon datasets (unzipped). Used by `shootagent ingest-autohdr` and the demo presets.
AUTOHDR_DEFECT_DIR=
AUTOHDR_CUSTOMER_DIR=
AUTOHDR_EDITOR_REQUESTS=

# Set to require a passcode header on a public deployment.
DEMO_PASSCODE=

# Memory budget. Defaults fit a 32 GB PC. On a 16-24 GB Apple-silicon laptop use smaller values; a QC run with
# the defaults peaked near 10 GiB there.
# TOOL_WORKERS=4
# QC_WORKERS=2
# FUSION_LONG_EDGE=4096
# SAM_MODEL=facebook/sam2.1-hiera-large   # facebook/sam2.1-hiera-base-plus is smaller
