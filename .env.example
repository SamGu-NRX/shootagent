# Claude drives the agent and the vision self-check. Either an API key, or a gateway URL + token.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:8317
# ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-sonnet-5-5

# OpenAI-compatible image edits for generative fills (gpt-image-2). Optional: without it, removals use local LaMa only.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
IMAGE_EDIT_MODEL=gpt-image-2

# Local models run on CUDA, Apple MPS or CPU. Leave empty to auto-detect.
TORCH_DEVICE=
DATA_DIR=data

# AutoHDR hackathon datasets (unzipped). Used by `shootagent ingest-autohdr` and the demo presets.
AUTOHDR_DEFECT_DIR=
AUTOHDR_CUSTOMER_DIR=
AUTOHDR_EDITOR_REQUESTS=

# Set to require a passcode header on a public deployment.
DEMO_PASSCODE=

# Listing launch. NTFY_TOPIC pushes each tour request to the realtor's phone (subscribe to the topic in the ntfy
# app). Anyone who knows the topic can read the notifications: pick a long random one and keep it out of git.
# PUBLIC_BASE_URL is the deployment's public origin, used for QR codes and notification links.
NTFY_TOPIC=
PUBLIC_BASE_URL=
# LISTING_QA_MODEL=claude-sonnet-5-5
# LISTING_QA_DAILY_USD=1.0

# Memory budget. Defaults fit a 32 GB PC with an 8 GB NVIDIA GPU. On the demo MacBook (Apple silicon) a QC
# run with the defaults on MPS peaked at 8-10 GiB, mostly PyTorch's MPS allocator cache (live tensors were
# about 1 GiB). These values measured 3.5-4.2 GiB per full QC run there (2026-10-28, 3 runs):
# TORCH_DEVICE=cpu
# SAM_MODEL=facebook/sam2.1-hiera-base-plus
# TOOL_WORKERS=2
# QC_WORKERS=1
# FUSION_LONG_EDGE=3072
